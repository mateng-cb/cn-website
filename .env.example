# 复制为 .env.local 使用（.env* 已 gitignore）
# 本机 1337 被其他项目占用，本项目 Strapi 固定 1338
STRAPI_URL=http://localhost:1338
# 站点绝对 URL 根（09 号工单）：canonical/og:url/sitemap/robots 拼接基准；生产覆盖为 https://suanlihaiyang.com
SITE_URL=http://localhost:3001
# Strapi → Next webhook 的共享密钥（与 strapi/.env 的 WEBHOOK_TOKEN 一致）
REVALIDATE_TOKEN=dev-webhook-shared-token
# Draft 预览链路（07 号工单）：/api/preview 入口密钥（与 cn-strapi/.env 的 PREVIEW_SECRET 一致）
PREVIEW_SECRET=dev-preview-secret
# 草稿取数只读 token（生产必填；dev 未设时自动读 ../cn-strapi/.preview-token）
# STRAPI_PREVIEW_TOKEN=

# --- Cloudflare Workers（OpenNext）路径（对照 web/docs/Cloudflare OpenNext 部署记录.md）---
# CF Workers Builds 的 Build 环境变量（须「构建时可用」，固化 sitemap/robots/canonical）：
#   SITE_URL=<门户公网地址：自定义域或 *.workers.dev>
#   STRAPI_URL=https://top-slhy.fintechquan.cn（测试环境；生产换 admin.suanlihaiyang.com）
# Worker 运行时变量（Workers → 设置 → 变量和机密，均需强随机值）：
#   REVALIDATE_TOKEN / PREVIEW_SECRET / STRAPI_PREVIEW_TOKEN
# Strapi webhook 目标在 CF 路径改公网 https://suanlihaiyang.com/api/revalidate
# （Docker 路径继续走容器网 NEXT_URL=http://next:3000，两路径互不影响）
